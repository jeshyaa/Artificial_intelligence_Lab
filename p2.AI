from collections import deque

def water_jug(jug1, jug2, target):
    queue = deque([((0, 0), [])])
    visited = set()

    while queue:
        (a, b), path = queue.popleft()

        if (a, b) in visited:
            continue

        visited.add((a, b))

        if a == target or b == target:
            print("Solution:")
            for step in path:
                print(step)
            print("Final State:", (a, b))
            return

        states = [
            ((jug1, b), "Fill Jug 1"),
            ((a, jug2), "Fill Jug 2"),
            ((0, b), "Empty Jug 1"),
            ((a, 0), "Empty Jug 2")
        ]

        pour = min(a, jug2 - b)
        states.append(((a - pour, b + pour), "Pour Jug 1 -> Jug 2"))

        pour = min(b, jug1 - a)
        states.append(((a + pour, b - pour), "Pour Jug 2 -> Jug 1"))

        for state, action in states:
            queue.append((state, path + [action]))

    print("No solution exists")


water_jug(4, 3, 2)
