from collections import deque

def is_valid(m, c):
    if m < 0 or c < 0 or m > 3 or c > 3:
        return False

    if m > 0 and m < c:
        return False

    if (3 - m) > 0 and (3 - m) < (3 - c):
        return False

    return True


def solve():
    start = (3, 3, 0)
    goal = (0, 0, 1)

    queue = deque([(start, [])])
    visited = set()

    moves = [
        (1, 0), (2, 0),
        (0, 1), (0, 2),
        (1, 1)
    ]

    while queue:
        state, path = queue.popleft()

        if state in visited:
            continue

        visited.add(state)

        if state == goal:
            print("Solution:")
            for step in path:
                print(step)
            print("Goal State:", state)
            return

        m, c, boat = state

        for dm, dc in moves:
            if boat == 0:
                new_state = (m - dm, c - dc, 1)
                action = f"{dm} Missionary, {dc} Cannibal ->"
            else:
                new_state = (m + dm, c + dc, 0)
                action = f"{dm} Missionary, {dc} Cannibal <-"

            if is_valid(new_state[0], new_state[1]):
                queue.append((new_state, path + [new_state]))

    print("No solution exists")


solve()
