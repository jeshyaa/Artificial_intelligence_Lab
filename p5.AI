from collections import deque

def solve_puzzle(start, goal):
    queue = deque([(start, [])])
    visited = set()

    while queue:
        state, path = queue.popleft()

        if state == goal:
            return path + [state]

        state_tuple = tuple(state)
        if state_tuple in visited:
            continue

        visited.add(state_tuple)

        zero = state.index(0)
        row = zero // 3
        col = zero % 3

        moves = []

        if row > 0:
            moves.append(zero - 3)

        if row < 2:
            moves.append(zero + 3)

        if col > 0:
            moves.append(zero - 1)

        if col < 2:
            moves.append(zero + 1)

        for move in moves:
            new_state = state.copy()
            new_state[zero], new_state[move] = \
                new_state[move], new_state[zero]

            queue.append((new_state, path + [state]))

    return None


start = [1, 2, 3,
         4, 0, 6,
         7, 5, 8]

goal = [1, 2, 3,
        4, 5, 6,
        7, 8, 0]

solution = solve_puzzle(start, goal)

if solution:
    print("Solution:")
    for state in solution:
        print(state[0:3])
        print(state[3:6])
        print(state[6:9])
        print()
else:
    print("No solution exists")
